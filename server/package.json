{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "npm run test:routes && npm run test:guard && npm run test:time && npm run test:slots && npm run test:bookings && node test/auth.integration.mjs && node test/rbac.integration.mjs && node test/vendors.integration.mjs && node test/uploads.integration.mjs && node test/catalog.integration.mjs && node test/availability.integration.mjs && node test/bookings.integration.mjs && node test/payments.integration.mjs",
    "test:routes": "ts-node test/route-coverage.ts",
    "test:guard": "ts-node test/approved-vendor-guard.ts",
    "test:time": "ts-node test/time.unit.ts",
    "test:slots": "ts-node test/slot-generator.unit.ts",
    "test:bookings": "ts-node test/bookings.unit.ts",
    "race": "ts-node scripts/race.ts",
    "test:seed-admins": "node test/make-admins.mjs",
    "openapi": "ts-node scripts/generate-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
