# Copy to .env and fill in. Never commit .env - .gitignore already blocks it.

# Neon. Use the POOLED endpoint (-pooler in the host) with an explicit
# connection_limit: scripts/race.ts opens 20 concurrent transactions and the
# free tier's direct limit is lower than that. See doc/features/M10_DELIVERY/plan.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=10"

# Exact client origins, comma-separated. No wildcard - credentials require exact.
CLIENT_ORIGIN="http://localhost:5173"

# Render injects PORT itself; only needed locally.
PORT=3000

# Phase 2 onward (M1). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=""
# JWT_REFRESH_SECRET=""
# ACCESS_TOKEN_TTL="15m"
# REFRESH_TOKEN_TTL="7d"

# Phase 7 onward (M7). Mock provider only - there is no real gateway in this project.
# PAYMENT_WEBHOOK_SECRET=""

# Phase 9 (M10). Seeded accounts share this password.
# SEED_DEFAULT_PASSWORD=""

# 'production' switches the refresh cookie to secure + sameSite=none.
NODE_ENV="development"
