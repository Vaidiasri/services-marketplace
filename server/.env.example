# Copy to .env and fill in. Never commit .env - .gitignore already blocks it.

# Use the POOLED Neon endpoint (-pooler). connection_limit must exceed the number of
# concurrent booking transactions you expect: each one holds a connection while it waits
# on a SlotCell row lock, so a limit of 10 makes scripts/race.ts fail with Prisma P2024
# (pool timeout) rather than the clean 409 the brief asks for. 25 comfortably covers the
# 20-way race. pool_timeout is how long a request waits for a free connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=25&pool_timeout=20"

# Comma-separated. An entry may contain one '*', matching a single DNS label, so
# "https://*.vercel.app" survives Vercel minting a new hostname on every deploy.
# A bare '*' is refused - a wildcard origin cannot carry credentials.
CLIENT_ORIGIN="http://localhost:5173"

# Render injects PORT itself; only needed locally.
PORT=3000

# REQUIRED from Phase 2. The API refuses to boot without it, or with one shorter than
# 32 characters. There is deliberately no fallback: a default would mean a deployment
# missing the variable silently signs tokens anyone can forge.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# There is no JWT_REFRESH_SECRET. Refresh tokens are 32 random bytes stored as a
# SHA-256 hash, not signed JWTs, so revocation is a database update rather than a
# denylist - which is what makes logout actually invalidate them server-side.

# Only read by test/make-admins.mjs. Never used by the application.
TEST_ADMIN_PASSWORD=""

# Where vendor documents are written. MUST stay outside any static mount - documents are
# streamed through an authenticated route, never served as static files, or anyone who
# guesses a filename reads another vendor's paperwork.
# Render's disk is ephemeral, so uploads vanish on redeploy and downloads answer 410.
# See doc/features/M3_VENDOR_ONBOARDING/plan.md.
UPLOAD_DIR="uploads/vendor-documents"

# Signs and verifies mock payment webhooks (HMAC-SHA256 over the raw body). Optional -
# it falls back to a known development value - but set it anywhere reachable from the
# internet, because the signature IS the authentication on POST /payments/webhook.
MOCK_WEBHOOK_SECRET="mock-webhook-secret"

# Every seeded account shares this password, and the README publishes it. Defaults to the
# value the integration suites use, so changing it means updating TEST_ADMIN_PASSWORD too.
SEED_PASSWORD="TestPass!2026"

# 'production' switches the refresh cookie to secure + sameSite=none.
NODE_ENV="development"
