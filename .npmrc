# Render (and most PaaS) force NODE_ENV=production, which makes npm imply omit=dev
# and skip devDependencies - but the build needs @nestjs/cli and typescript from
# there. npm resolves include over omit regardless of order, so this wins.
#
# Deliberately here rather than in the build command: it holds no matter what the
# host's dashboard field says, and the first two failed deploys were both a
# dashboard command drifting from render.yaml.
include=dev
